# Substrate pre-commit config.
# Profile markers: bootstrap.sh strips blocks not matching the selected
# profile. starter < standard < strict (each level includes the ones
# below it). python-only blocks are stripped when --lang != python.
repos:
  - repo: local
    hooks:
      # --- core (all profiles, all languages) ---
      - id: check-import-shadowing
        name: No repo-local stdlib shadowing
        entry: {{PY}} -I scripts/check_import_shadowing.py
        language: system
        pass_filenames: false
        always_run: true
      - id: update-manifest-check
        name: Manifest is current
        entry: {{PY}} -I scripts/update_manifest.py --check
        language: system
        pass_filenames: false
        always_run: true
      - id: check-doc-drift
        name: Docs/code drift check
        entry: {{PY}} -I scripts/check_doc_drift.py --strict
        language: system
        pass_filenames: false
        always_run: true
      - id: check-python-syntax
        name: Governed Python compiles (no fail-open hooks)
        entry: {{PY}} -I scripts/check_python_syntax.py
        language: system
        pass_filenames: false
        always_run: true
      - id: check-harness-patterns
        name: Harness safety-policy data is intact
        entry: {{PY}} -I scripts/check_harness_patterns.py
        language: system
        pass_filenames: false
        always_run: true
      - id: check-policy-code-integrity
        name: Policy + scanner logic is intact (AST-pinned)
        entry: {{PY}} -I scripts/check_policy_code_integrity.py
        language: system
        pass_filenames: false
        always_run: true
      - id: check-raw-file-io
        name: No raw file IO on a repo-derived path
        entry: {{PY}} -I scripts/check_raw_file_io.py
        language: system
        pass_filenames: false
        always_run: true
      - id: check-harness-smoke
        name: Agent-harness scanner blocks injected context
        entry: {{PY}} -I scripts/check_harness_smoke.py
        language: system
        pass_filenames: false
        always_run: true
      - id: check-hook-smoke
        name: Security hooks actually deny (behavioral)
        entry: {{PY}} -I scripts/check_hook_smoke.py
        language: system
        pass_filenames: false
        always_run: true
      - id: check-substrate-config
        name: .substrate/config is safe data
        entry: {{PY}} -I scripts/check_substrate_config.py
        language: system
        pass_filenames: false
        always_run: true
      - id: check-agent-harness
        name: Agent harness safety check
        entry: {{PY}} -I scripts/check_agent_harness.py
        language: system
        pass_filenames: false
        always_run: true
      - id: check-secrets
        name: Secrets scan
        entry: {{PY}} -I scripts/check_secrets.py
        language: system
        pass_filenames: false
        always_run: true
      - id: check-history-sha
        name: HISTORY SHA validity
        entry: {{PY}} -I scripts/check_history_sha.py
        language: system
        pass_filenames: false
        always_run: true
      # >>> standard
      # >>> python-only
      - id: ruff-format
        name: Ruff format
        entry: bash scripts/run_python_gate.sh format
        language: system
        files: \.py$
        pass_filenames: true
      - id: ruff-check
        name: Ruff check
        entry: bash scripts/run_python_gate.sh lint
        language: system
        files: \.py$
        pass_filenames: true
      - id: smoke-tests
        name: Pytest
        entry: bash scripts/run_python_gate.sh test
        language: system
        pass_filenames: false
        always_run: true
      # <<< python-only
      - id: check-postmortem-gates-resolved
        name: Postmortem gates resolve to real files
        entry: {{PY}} -I scripts/check_postmortem_gates_resolved.py
        language: system
        files: ^docs/postmortems/.*\.md$
        pass_filenames: false
      # <<< standard
      # >>> strict
      - id: check-postmortem-for-bug-fix
        name: Bug-fix commit-msg postmortem requirement
        entry: {{PY}} -I scripts/check_postmortem_for_bug_fix.py
        language: system
        stages: [commit-msg]
      - id: check-finding-response
        name: Audit-finding response fields required
        entry: {{PY}} -I scripts/check_finding_response.py
        language: system
        stages: [commit-msg]
      # >>> python-only
      - id: check-validator-input-coverage
        name: Validators have paired adversarial tests
        entry: {{PY}} -I scripts/check_validator_input_coverage.py --all
        language: system
        files: ^scripts/check_.*\.py$
        pass_filenames: false
      # <<< python-only
      # <<< strict
      - id: substrate-audit-manual
        name: Substrate audit report
        entry: {{PY}} -I scripts/substrate_audit.py --mode quick --write-report
        language: system
        stages: [manual]
        pass_filenames: false
