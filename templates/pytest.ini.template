[pytest]
# Deterministic, hermetic source-root runs. Disable random ordering so
# subprocess-heavy hook tests run in a stable order; disable the cache
# provider so stale state can't leak between runs. Every test that spawns
# a subprocess sets its own hard timeout (see tests/test_hook_scripts.py),
# and conftest.py forces SUBSTRATE_LINT_DIRECT so no test triggers a
# `uv run` venv build.
addopts = -p no:randomly -p no:cacheprovider -q
testpaths = tests
# Make the project importable from tests/ for BOTH common layouts without the
# consumer having to edit this substrate-owned file (real-repo trial #1): "." for a
# flat/root package, "src" for a src/-layout package. pytest ignores paths that
# don't exist, so shipping both is harmless. Add your own roots here if needed.
pythonpath = . src
