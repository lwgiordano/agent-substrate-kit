# DORMANT TEMPLATE — activate with `./manage.sh enable auto-upgrade` (copies this into
# .github/workflows/). Scheduled substrate self-upgrade: fetch the latest signed kit release,
# VERIFY it (fail-closed), apply the in-place upgrade, and open a PR. No signing key, no secret
# — it only verifies + proposes; a human/branch-protection merge applies it. Pure consume-side
# automation with no trust tradeoff.
#
# Set KIT_REPO below to your kit's repo (owner/name). Adjust the schedule as you like.
name: Substrate auto-upgrade
on:
  schedule:
    - cron: "0 6 * * 1"   # weekly, Monday 06:00 UTC
  workflow_dispatch: {}
permissions:
  contents: write        # push the upgrade branch
  pull-requests: write   # open the PR
env:
  KIT_REPO: lwgiordano/agent-substrate-kit
jobs:
  upgrade:
    runs-on: ubuntu-latest
    steps:
      # No credentials on disk while the upgrade engine runs; only the last step
      # pushes, with the token passed to it alone (v3.10.5).
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with: {fetch-depth: 0, persist-credentials: false}
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7
        with: {python-version: "3.11"}
      - name: Fetch the latest signed release
        env: {GH_TOKEN: "${{ github.token }}"}
        run: |
          mkdir -p _upgrade && cd _upgrade
          # Assets a release does not carry are skipped by gh; any other failure
          # fails the job rather than letting the upgrade run on nothing.
          gh release download --repo "$KIT_REPO" --pattern '*.zip' --pattern '*.minisig' --pattern '*.sigstore' --pattern '*.sha256'
      - name: Upgrade in place (the engine verifies the signature itself, fail-closed)
        run: |
          python3 -m pip install --quiet cryptography==50.0.2
          ZIP="$(ls _upgrade/*.zip | grep -v -- '-review-bundle' | head -1)"
          # `upgrade` runs the SAME multi-backend verifier internally (fail-closed), so the
          # consume path never bypasses the engine's own trust check (v3.7.19).
          ./manage.sh upgrade --from "$ZIP" --write
      - name: Open an upgrade PR if anything changed
        env: {GH_TOKEN: "${{ github.token }}"}
        run: |
          rm -rf _upgrade
          if [ -z "$(git status --porcelain)" ]; then echo "already current"; exit 0; fi
          BR="substrate-upgrade-$(date -u +%Y%m%d)"
          git config user.name "substrate-bot"; git config user.email "substrate-bot@users.noreply.github.com"
          git checkout -b "$BR" && git add -A && git commit -qm "chore: substrate upgrade (verified release)"
          git push "https://x-access-token:${GH_TOKEN}@github.com/${GITHUB_REPOSITORY}.git" "$BR"
          gh pr create --title "Substrate upgrade (verified)" --body "Automated: verified the signed kit release and applied \`manage.sh upgrade\`. Review the diff before merging." --head "$BR"
