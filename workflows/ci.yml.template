name: CI
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch:
jobs:
  checks:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
        with: {fetch-depth: 0}
      # The substrate's own validators are Python (stdlib + PyYAML),
      # regardless of the project's primary language.
      - uses: actions/setup-python@v5
        with: {python-version: "3.11"}
      - name: Bootstrap toolchain ({{LANG}})
        run: |
          set -euo pipefail
          if [ -f pyproject.toml ]; then
            pipx install uv
            # --all-extras installs dev tooling no matter how the project declares it:
            # [project.optional-dependencies] dev (via extras) OR PEP 735
            # [dependency-groups] dev (uv syncs the 'dev' group by default). `--group dev`
            # alone errors/no-ops on the optional-dependencies style (real-repo trial #1).
            uv sync --all-extras
          else
            python -m pip install --upgrade pip PyYAML pre-commit
          fi
      - name: Node toolchain
        if: hashFiles('package.json') != ''
        uses: actions/setup-node@v4
        with: {node-version: "20"}
      - name: Node install
        if: hashFiles('package.json') != ''
        run: npm ci || npm install
      - name: Go toolchain
        if: hashFiles('go.mod') != ''
        uses: actions/setup-go@v5
        with: {go-version: "stable"}
      - name: Substrate setup (creates .substrate/venv with validators)
        run: ./manage.sh setup
      - name: Doctor (readiness — --strict for strict profile, else --operational)
        run: |
          MODE=--operational
          grep -q 'SUBSTRATE_PROFILE="strict"' .substrate/config && MODE=--strict
          ./manage.sh doctor "$MODE"
      - name: Substrate + language checks
        run: ./manage.sh check
      # v3.9.0: containment is MEASURED in CI, not skipped. Without a backend the
      # sandbox eval reported "skipped" and left the denominator; with
      # --require-sandbox-evals a skip is a failure.
      - name: OS sandbox backend (bubblewrap)
        if: runner.os == 'Linux'
        run: |
          set -euo pipefail
          sudo apt-get update -qq
          sudo apt-get install -y -qq bubblewrap
          # Ubuntu 24.04 restricts unprivileged user namespaces through AppArmor,
          # so bwrap cannot build its sandbox and every probe fails for the wrong
          # reason. Lift it on this throwaway runner, then prove bwrap RUNS code.
          if [ -e /proc/sys/kernel/apparmor_restrict_unprivileged_userns ]; then
            sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
          fi
          bwrap --unshare-net --dev-bind / / true
      - name: Behavior evals (sandbox containment required)
        run: ./manage.sh evals --require-sandbox-evals
      - name: Restore the AppArmor userns restriction
        if: always() && runner.os == 'Linux'
        run: |
          if [ -e /proc/sys/kernel/apparmor_restrict_unprivileged_userns ]; then
            sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=1
          fi
      # Live GitHub governance (branch protection, required reviews) can only be
      # read with an admin-readable token (the SUBSTRATE_ADMIN_TOKEN secret). The
      # token is scoped to the ONE step that needs it — never job-level env, where
      # every test and hook above could read it — and that step never runs on a
      # pull_request, whose code is not yet reviewed and could print it.
      - name: Detect the admin token
        id: admin
        env:
          T: ${{ secrets.SUBSTRATE_ADMIN_TOKEN }}
        run: echo "present=$([ -n "$T" ] && echo yes || echo no)" >> "$GITHUB_OUTPUT"
      - name: Remote governance (live branch protection)
        if: steps.admin.outputs.present == 'yes' && github.event_name != 'pull_request'
        env:
          GITHUB_TOKEN: ${{ secrets.SUBSTRATE_ADMIN_TOKEN }}
          GITHUB_REPOSITORY: ${{ github.repository }}
        run: ./manage.sh enable remote --check
      - name: Remote governance not verified
        if: steps.admin.outputs.present != 'yes' || github.event_name == 'pull_request'
        run: echo "::notice::Live branch protection NOT verified in this run (no SUBSTRATE_ADMIN_TOKEN secret, or a pull_request, which never receives it)."
