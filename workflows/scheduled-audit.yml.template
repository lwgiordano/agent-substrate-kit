name: Scheduled audit
on:
  schedule:
    - cron: "0 9 * * 1"
  workflow_dispatch:
    inputs:
      pytest_timeout:
        description: "Seconds the audit's pytest run may take (60-3600; empty = default 1200). A small value forces a TIMEOUT to test the alert path."
        required: false
        default: ""
jobs:
  scheduled-audit:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    # GITHUB_TOKEN gets only what this job uses. Without `issues: write` the
    # failure issue below was refused with HTTP 403 on every failing run, so
    # audit failures were silent (v3.10.2).
    permissions:
      contents: read
      issues: write
    steps:
      - uses: actions/checkout@v7
        with: {fetch-depth: 0}
      - uses: actions/setup-python@v5
        with: {python-version: "3.11"}
      - name: Bootstrap toolchain
        run: |
          set -euo pipefail
          if [ -f pyproject.toml ]; then
            pipx install uv
            # --all-extras covers both dev-declaration styles (optional-dependencies +
            # PEP 735 dependency-groups); `--group dev` no-ops on the former (trial #1).
            uv sync --all-extras
          else
            python -m pip install --upgrade pip PyYAML pre-commit
          fi
      - name: Substrate setup (so audit uses .substrate/venv tools, not ambient)
        run: ./manage.sh setup
      - name: Write substrate audit report
        id: audit
        # Passed through env, never interpolated into the script; the audit
        # rejects any value that is not whole seconds in range.
        env:
          SUBSTRATE_AUDIT_PYTEST_TIMEOUT: ${{ github.event.inputs.pytest_timeout }}
        run: ./manage.sh full-audit
      # Preserve the report — an ephemeral runner discards ai/audits/
      # otherwise. always() so a failing audit still uploads evidence.
      - name: Upload audit report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: substrate-audit-report
          path: ai/audits/**
          retention-days: 30
          if-no-files-found: warn
      # Strict installs: surface a failed scheduled audit as an issue
      # instead of a silently-red cron run.
      - name: Open issue on audit failure
        if: failure()
        uses: actions/github-script@v7
        with:
          script: |
            // One open issue per failure streak: later failures comment on it.
            const label = 'substrate-audit';
            try {
              await github.rest.issues.getLabel({ ...context.repo, name: label });
            } catch (e) {
              if (e.status !== 404) throw e;
              await github.rest.issues.createLabel({ ...context.repo, name: label,
                color: 'b60205', description: 'Scheduled substrate audit failed' });
            }
            const sha = context.sha.slice(0, 7);
            const body = `The scheduled substrate audit failed on ${new Date().toISOString()} at ${sha}.\nRun: ${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId}\nThe log names each check as PASS, BLOCK or TIMEOUT; download the \`substrate-audit-report\` artifact for the full report.`;
            const open = await github.rest.issues.listForRepo({ ...context.repo,
              state: 'open', labels: label, per_page: 1 });
            if (open.data.length) {
              await github.rest.issues.createComment({ ...context.repo,
                issue_number: open.data[0].number, body });
            } else {
              await github.rest.issues.create({ ...context.repo,
                title: `Scheduled substrate audit failed (${sha})`, body, labels: [label] });
            }
